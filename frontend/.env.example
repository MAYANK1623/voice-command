# Only needed for a SPLIT deploy (frontend and backend as two separate
# hosted services/origins). Leave unset for the recommended single-service
# deploy, where this frontend is built and served by the backend itself
# (see backend/src/index.ts) — relative "/api/..." paths just work.
#
# If split, set this to the deployed API's full origin (no trailing slash,
# no /api suffix — that's added automatically):
#   VITE_API_BASE_URL=https://your-backend.onrender.com
